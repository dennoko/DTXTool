/* DTXTool 固有クラス。DennokoTheme.uss → DennokoBlocks.uss の後に読む。
   必ず .dennoko-root を前置する（skill references/uss-conventions.md）。色は var(--dennoko-*) のみ。
   画面の部品はできるだけ skill のクラス（.dennoko-*）で組み、ここには skill に無いものだけを置く。 */

.dennoko-root .mm-indent {
    margin-left: 16px;
}

/* スクロール領域の最初のカードはトップバー / バナーから少し離す（.dennoko-card は上の余白が 0） */
.dennoko-root .dennoko-scroll .dennoko-card.dennoko-target-card,
.dennoko-root .dennoko-scroll.mm-layout-settings .dennoko-card {
    margin-top: 8px;
}

/* ─── B1 対象カード ─── */

/* 候補一覧の行の中のアイコン（Renderer の種類） */
.dennoko-root .dennoko-candidate > .dennoko-icon {
    flex-shrink: 0;
}

/* 候補一覧で今の対象として決めた行 */
.dennoko-root .unity-button.dennoko-candidate.dennoko-button-active,
.dennoko-root .unity-button.dennoko-candidate.dennoko-button-active:hover {
    background-color: var(--dennoko-selection-bg);
    border-color: var(--dennoko-selection-border);
}

/* ─── B3 UV ビュー ─── */

/* .dennoko-preview は中身を中央に寄せる（align-items: center）ので、UV ビューは全面に広げる */
.dennoko-root .dennoko-preview.mm-uv-host {
    height: 320px;
    min-height: 160px;
    align-items: stretch;
}

.dennoko-root .mm-uv-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dennoko-root .mm-uv-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* テクスチャをドラッグ中（ドロップで取り込み） */
.dennoko-root .mm-uv-host.mm-drop-target {
    border-color: var(--dennoko-selection-border);
}

.dennoko-root .mm-drop-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 45%;
    -unity-text-align: middle-center;
    color: var(--dennoko-selection-border);
}

.dennoko-root .mm-base-alpha {
    margin-top: 4px;
}

/* ─── B5 出力カード ─── */

.dennoko-root .mm-ext {
    flex-shrink: 0;
    margin-left: 4px;
}

/* Base PNG の大きさで解像度が決まっているとき（ボタンの右に実際の大きさ） */
.dennoko-root .mm-size-locked {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
}

/* チャンネルの R / G / B / A は文字の幅で並べる（伸ばさない） */
.dennoko-root .dennoko-segmented.dennoko-choice-group.mm-channels {
    align-self: flex-start;
    margin-bottom: 2px;
}

.dennoko-root .dennoko-segmented.dennoko-choice-group.mm-channels > .unity-button {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 28px;
}

/* 上書きマーク ●（プロジェクトの既定から変えている。クリックで既定に戻す） */
.dennoko-root .mm-override-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: var(--dennoko-selection-border);
}

/* ─── ステータス行（ステータス + 操作ボタン 1 つ。Label に子要素を足さないため横に並べる） ─── */

.dennoko-root .mm-status-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.dennoko-root .mm-status-row > .dennoko-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ステータスの下余白（6px）と揃える */
.dennoko-root .mm-status-row > .unity-button.mm-status-action {
    flex-shrink: 0;
    min-height: 0;
    height: 20px;
    margin: 0 8px 6px -4px;
    font-size: 10px;
}

/* ─── UV 展開図ウィンドウ（左: プレビュー、右: 設定） ─── */

.dennoko-root .mm-layout-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.dennoko-root .dennoko-preview.mm-layout-preview {
    flex-grow: 1;
    height: auto;
    min-width: 160px;
    margin: 8px 0 8px 8px;
}

.dennoko-root .dennoko-scroll.mm-layout-settings {
    flex-grow: 0;
    width: 300px;
}

/* ラベル列（100px〜30%）だと 300px の設定欄では選択肢が窮屈なので狭める */
.dennoko-root .mm-layout-settings .dennoko-field-row__label {
    min-width: 72px;
    width: 72px;
}

.dennoko-root .mm-layout-settings .dennoko-field-row {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* ═══════════ DTXTool: レイヤー一覧・設定カード ═══════════ */

/* 範囲選択の案内（範囲を選んでいる間だけ出るカード。作業中バナーと同じ selection 色で「今のモード」を示す） */
.dennoko-root .dennoko-card.dtx-select-card {
    border-color: var(--dennoko-selection-border);
    background-color: var(--dennoko-selection-bg);
}

.dennoko-root .dtx-select-card__header {
    align-items: center;
    margin-bottom: 2px;
}

.dennoko-root .dtx-select-card__title {
    color: var(--dennoko-text-primary);
    -unity-font-style: bold;
    margin-bottom: 0;
}

.dennoko-root .unity-button.dtx-select-all-button {
    flex-shrink: 0;
    min-height: 0;
    height: 22px;
    padding: 0 8px;
    margin-left: 6px;
    font-size: 11px;
}

/* ヘッダーの「+全体」コンパクトボタン */
.dennoko-root .unity-button.dtx-header-chip-button {
    flex-shrink: 0;
    min-height: 0;
    height: 20px;
    padding: 0 6px;
    margin: 0 2px;
    font-size: 10px;
}

/* 空状態のアクション行（範囲を選択 / 全体を追加） */
.dennoko-root .dtx-empty-actions {
    justify-content: center;
    margin-top: 4px;
}

.dennoko-root .dtx-empty-actions > .unity-button {
    margin: 0 3px;
}

.dennoko-root .dtx-keyhints {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

/* レイヤー一覧（上が最上段）。行は対象カードの候補行（.dennoko-candidate）と同じ見た目にする */
.dennoko-root .dtx-layer-list {
    flex-direction: column;
}

.dennoko-root .unity-button.dennoko-candidate.dtx-layer-row {
    flex-shrink: 0;
    margin-bottom: 2px;
}

/* 非表示のレイヤーは名前を薄くする */
.dennoko-root .dtx-layer-row--hidden .dennoko-candidate__name {
    color: var(--dennoko-text-disabled);
}

/* 下地の行は一覧の最下段に固定（上に区切り線） */
.dennoko-root .unity-button.dennoko-candidate.dtx-layer-row--background {
    margin-top: 4px;
    margin-bottom: 0;
}

/* 行の左の目（表示切替）。下地の行は同じ幅の空きを置いて名前の位置を揃える */
.dennoko-root .dtx-layer-row__eye {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

/* 質感の見本（色、またはテクスチャの縮小表示。色そのものはデータなので C# が入れる） */
.dennoko-root .dtx-swatch {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--dennoko-outline);
    border-radius: 3px;
}

/* カードの中の小見出し（マスク など） */
.dennoko-root .dtx-subtitle {
    margin-top: 8px;
    margin-bottom: 2px;
    font-size: 10px;
    color: var(--dennoko-text-tertiary);
    -unity-font-style: bold;
}

/* ラベル付きの行の中の、値を示すだけの文字 */
.dennoko-root .dtx-value-label {
    -unity-text-align: middle-left;
    color: var(--dennoko-text-secondary);
}

/* ラベル付きの行の右端の操作ボタン */
.dennoko-root .unity-button.dtx-row-action {
    flex-shrink: 0;
    margin-left: 6px;
}

/* PSD の参照表示・ワンクリック上書き保存・別名保存 / 読み込み */
.dennoko-root .dtx-psd-linked {
    align-items: center;
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 3px 6px;
    border-radius: 4px;
    background-color: var(--dennoko-surface-0);
    border-width: 1px;
    border-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dtx-psd-linked__icon {
    flex-shrink: 0;
    margin-right: 6px;
}

.dennoko-root .dtx-psd-linked__name {
    font-size: 11px;
    color: var(--dennoko-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 4px;
}

.dennoko-root .unity-button.dtx-psd-overwrite {
    height: 28px;
    margin: 2px 0 4px 0;
    -unity-font-style: bold;
}

.dennoko-root .dtx-psd-row {
    margin-top: 4px;
}

.dennoko-root .dtx-psd-row > .unity-button {
    flex-basis: 0;
}

/* 範囲選択中の UV ビュー（スクロール領域の外に固定。縮めずに高さを決めておき、残りをスクロール領域に回す） */
.dennoko-root .dennoko-card.dtx-uv-card {
    flex-shrink: 0;
    margin-top: 8px;
}

.dennoko-root .dtx-uv-card .dennoko-preview.mm-uv-host {
    height: 260px;
}

/* レイヤー一覧の下の、選択中レイヤーの名前・ブレンド・不透明度 */
.dennoko-root .dtx-layer-props {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dtx-layer-props__row {
    align-items: center;
    margin-bottom: 2px;
}

.dennoko-root .dtx-layer-props__row > .unity-text-field {
    margin-left: 0;
}

.dennoko-root .dtx-layer-props__row > .unity-base-popup-field.dtx-layer-props__blend {
    flex-shrink: 0;
    width: 104px;
    margin-left: 4px;
    margin-right: 0;
}

/* マスクカードの「範囲を再調整」（カードで一番よく押すので大きくする。主ボタンはフッターの 1 つだけなので白塗りにはしない） */
.dennoko-root .unity-button.dtx-reselect-button {
    height: 28px;
    margin: 2px 0 6px 0;
    -unity-font-style: bold;
}

/* テクスチャ欄の下の配置（字下げで、どのテクスチャの配置かを示す） */
.dennoko-root .dtx-placement {
    margin-bottom: 4px;
}

/* 方式の行の右端のアイコンボタン（初期値に戻す） */
.dennoko-root .unity-button.dtx-row-icon {
    flex-shrink: 0;
    margin-left: 4px;
}

/* 出力ドックのラベル（「ファイル名」が入る幅にする） */
.dennoko-root .dtx-output-dock .dennoko-output__label {
    width: 56px;
}

/* 解像度行の右のスペースに出力対象チェックボックスを並べる（狭い幅では折り返す） */
.dennoko-root .dtx-output-size-row {
    flex-wrap: wrap;
}

.dennoko-root .dtx-output-targets {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.dennoko-root .dtx-output-targets > .unity-toggle {
    margin-right: 8px;
}

.dennoko-root .dtx-output-targets > .unity-toggle:last-child {
    margin-right: 0;
}

/* フッターの「取消」は幅を固定し、主ボタンを伸ばす */
.dennoko-root .dennoko-footer > .unity-button.dennoko-button-secondary {
    flex-shrink: 0;
}

/* フッターの「上書き」チェックボックス（主ボタンの左。縮めない） */
.dennoko-root .dennoko-footer > .dtx-footer-toggle {
    flex-shrink: 0;
    margin: 0 8px 0 2px;
}

/* 対象カードのモード切替と作業開始ボタン */
.dennoko-root .dtx-edit-mode-row {
    margin-top: 6px;
}

.dennoko-root .unity-button.dtx-target-start {
    margin-top: 6px;
    height: 28px;
    -unity-font-style: bold;
}
